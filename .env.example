# Public PostHog project token. Set it in Vercel for Production and Preview.
# Leave it unset to disable analytics entirely (local dev, forks).
VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token

# Ingest host. Defaults to the first-party /ingest path, which vercel.json (prod)
# and vite.config.ts (dev) rewrite to PostHog so ad blockers don't drop events.
# Override with https://us.i.posthog.com to talk to PostHog directly.
# VITE_POSTHOG_HOST=/ingest

# Where "view in PostHog" links point when the API host is a proxy path.
# Use https://eu.posthog.com if the project lives in the EU region.
# VITE_POSTHOG_UI_HOST=https://us.posthog.com
